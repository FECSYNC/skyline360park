DirectoryIndex index.html

# Some cPanel/LiteSpeed stacks ship an incomplete mime map. An .mp4 handed back
# as application/octet-stream downloads instead of playing, and a .webp sent as
# text/plain is dropped by the <picture> element.
<IfModule mod_mime.c>
  AddType video/mp4 .mp4 .m4v
  AddType video/webm .webm
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Safari and iOS will not start a video the server refuses to seek into.
<IfModule mod_headers.c>
  <FilesMatch "\.(mp4|m4v|webm)$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>

# Re-compressing an already-compressed container burns CPU and, on some hosts,
# strips the range support above. Safari and iOS refuse a video the server will
# not let them seek into, so the match has to survive a ?v= cache-buster rather
# than anchoring at the end of the URL.
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI \.(?:mp4|m4v|webm|jpe?g|png|webp|gif|woff2?)($|\?) no-gzip dont-vary
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Heavy media is safe to hold for a year: it is replaced under a new filename or
# a bumped ?v=, never edited in place.
#
# The stylesheet, script and UI chrome SVGs are a different story — they are
# edited in place on every design change, and the HTML that depends on them is
# never cached. Holding them for a week meant a returning visitor got fresh
# markup against a stale stylesheet, which renders as a warped layout on their
# device only. They now revalidate on each load: unchanged files come back as an
# empty 304, so the cost is one small conditional request, not a re-download.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# mod_expires alone emits max-age=0, which some mobile browsers and ISP proxies
# still treat as "reuse until I feel like asking". must-revalidate removes the
# ambiguity.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|gif|mp4|webm|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Keep SMTP mailbox passwords from being downloaded as plain text.
# NOTE: Do not use "Require all denied" here — on some LiteSpeed setups that
# also blocks PHP include() of the config and silently disables SMTP.
# waiver-smtp-config.php and waiver-id-scan-config.php already return 403 when
# opened directly in a browser.
